# Life OS Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ===================
# LLM API Keys
# ===================

# Zhipu AI (GLM-4) - Primary model
GLM_API_KEY=your_zhipu_api_key_here

# Anthropic (Claude) - Fallback model
CLAUDE_API_KEY=your_anthropic_api_key_here

# ===================
# Research Tools
# ===================

# NCBI/PubMed API key
PUBMED_API_KEY=your_ncbi_api_key_here

# Serper API for web search
SERPER_API_KEY=your_serper_api_key_here

# ===================
# Infrastructure
# ===================

# Redis URL (for message bus and caching)
REDIS_URL=redis://localhost:6379

# PostgreSQL URL (for persistent storage)
DATABASE_URL=postgresql://life-os:password@localhost:5432/life_os

# ===================
# Security
# ===================

# API secret for authenticating requests from Clawdbot
LIFE_OS_API_SECRET=generate_a_secure_random_string_here

# ===================
# Optional Services
# ===================

# OpenAI (for embeddings if using OpenAI)
# OPENAI_API_KEY=your_openai_api_key_here

# ===================
# Development
# ===================

# Environment: development, staging, production
ENVIRONMENT=development

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Master Router settings
ROUTER_HOST=0.0.0.0
ROUTER_PORT=8000
