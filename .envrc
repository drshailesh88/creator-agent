# direnv configuration for Life OS development
#
# This file automatically sets up the development environment when you
# enter the project directory.
#
# Setup:
# 1. Install direnv: nix-env -i direnv
# 2. Add to shell: eval "$(direnv hook bash)"  # or zsh/fish
# 3. Allow this file: direnv allow
#
# See: https://direnv.net/

# Use the flake's devShell
use flake

# =============================================================================
# DEVELOPMENT ENVIRONMENT VARIABLES
# =============================================================================

# Python path for local development
export PYTHONPATH="${PWD}/src:${PYTHONPATH:-}"

# Local development settings
export LIFE_OS_ENV="development"
export LIFE_OS_DEBUG="true"

# API Configuration (development defaults)
export ROUTER_HOST="127.0.0.1"
export ROUTER_PORT="8000"
export CONTENT_PORT="8001"
export BUSINESS_PORT="8002"
export PERSONAL_PORT="8003"

# Database (local development)
export DATABASE_URL="postgresql://life-os@localhost/life_os"
export REDIS_URL="redis://localhost:6379"

# Data directory (local)
export DATA_DIR="${PWD}/.data"

# LLM Settings (use .env file for actual keys)
export DEFAULT_MODEL="glm-4"
export FALLBACK_MODEL="claude-3-5-haiku-20241022"

# =============================================================================
# OPTIONAL: Load .env file for secrets
# =============================================================================

# Create a .env file with your API keys for local development
# NEVER commit .env to git!
if [[ -f .env ]]; then
  dotenv .env
fi

# Or use .env.local for machine-specific overrides
if [[ -f .env.local ]]; then
  dotenv .env.local
fi

# =============================================================================
# PATH ADDITIONS
# =============================================================================

# Add local bin to PATH
PATH_add "${PWD}/bin"
PATH_add "${PWD}/scripts"

# =============================================================================
# TERRAFORM/OPENTOFU
# =============================================================================

# Infrastructure directory
export TF_DATA_DIR="${PWD}/infra/.terraform"

# =============================================================================
# HELPFUL ALIASES VIA ENVIRONMENT
# =============================================================================

# These can be used in your shell after direnv loads
# alias lo-start="python -m uvicorn master_router.main:app --reload"
# alias lo-test="pytest tests/"

# =============================================================================
# DEVELOPMENT HELPERS
# =============================================================================

# Create local data directory if needed
mkdir -p "${DATA_DIR}/content" "${DATA_DIR}/business" "${DATA_DIR}/personal" "${DATA_DIR}/memory" 2>/dev/null || true

# Print welcome message
echo ""
echo "Life OS Development Environment"
echo "================================"
echo "Python path: ${PYTHONPATH}"
echo "Data dir:    ${DATA_DIR}"
echo ""
echo "Quick start:"
echo "  Start router:  python -m uvicorn src.master_router.main:app --reload"
echo "  Run tests:     pytest tests/"
echo "  Build image:   nix build .#life-os-image"
echo ""
