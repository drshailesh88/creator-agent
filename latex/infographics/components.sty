% DrShailesh Infographic Components Library
% Usage: \usepackage{components}
%
% Provides reusable TikZ components for building infographics:
% - Charts (pie, bar, donut)
% - Cards (info, stat, comparison)
% - Icons and badges
% - Timelines and flows
% - Medical-specific components

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{components}[2024/01/14 Infographic Components]

\RequirePackage{tikz}
\RequirePackage{xcolor}
\RequirePackage{fontawesome5}
\RequirePackage{brand-colors}

\usetikzlibrary{
    shapes.geometric,
    arrows.meta,
    positioning,
    calc,
    decorations.pathreplacing,
    patterns
}

% =============================================================================
% PIE CHART
% =============================================================================
% Usage: \piechart{x}{y}{radius}{{value1/color1/label1},{value2/color2/label2},...}
\newcommand{\piechart}[4]{
    \def\radius{#3}
    \def\data{#4}
    \pgfmathsetmacro{\cumulative}{0}
    \foreach \value/\colour/\label in \data {
        \pgfmathsetmacro{\newcumulative}{\cumulative + \value}
        \pgfmathsetmacro{\midangle}{(\cumulative + \newcumulative) / 2 * 3.6}
        \fill[\colour] (#1,#2) -- +(\cumulative*3.6:\radius) arc (\cumulative*3.6:\newcumulative*3.6:\radius) -- cycle;
        % Label
        \pgfmathsetmacro{\labelradius}{\radius * 1.3}
        \node[font=\sffamily\small] at ($(#1,#2)+(\midangle:\labelradius)$) {\label};
        \global\let\cumulative\newcumulative
    }
}

% =============================================================================
% DONUT CHART
% =============================================================================
% Usage: \donutchart{x}{y}{outer radius}{inner radius}{{value/color/label},...}
\newcommand{\donutchart}[5]{
    \def\outerradius{#3}
    \def\innerradius{#4}
    \def\data{#5}
    \pgfmathsetmacro{\cumulative}{0}
    \foreach \value/\colour/\label in \data {
        \pgfmathsetmacro{\newcumulative}{\cumulative + \value}
        \pgfmathsetmacro{\midangle}{(\cumulative + \newcumulative) / 2 * 3.6}
        \fill[\colour] (#1,#2) +(\cumulative*3.6:\innerradius) -- +(\cumulative*3.6:\outerradius)
            arc (\cumulative*3.6:\newcumulative*3.6:\outerradius) -- +(\newcumulative*3.6:\innerradius)
            arc (\newcumulative*3.6:\cumulative*3.6:\innerradius) -- cycle;
        \global\let\cumulative\newcumulative
    }
}

% =============================================================================
% HORIZONTAL BAR CHART
% =============================================================================
% Usage: \hbar{x}{y}{width}{height}{percent}{color}{label}
\newcommand{\hbar}[7]{
    \fill[BrandText!15, rounded corners=2pt] (#1,#2) rectangle (#1+#3,#2+#4);
    \fill[#6, rounded corners=2pt] (#1,#2) rectangle (#1+#3*#5/100,#2+#4);
    \node[font=\sffamily\small, anchor=west, text=BrandText] at (#1+#3+0.2,#2+#4/2) {#5\% #7};
}

% =============================================================================
% COMPARISON CARD
% =============================================================================
% Usage: \comparisoncard{x}{y}{width}{title1}{value1}{title2}{value2}
\newcommand{\comparisoncard}[7]{
    \node[brand box, minimum width=#3, minimum height=60pt] at (#1,#2) {};
    % Left side
    \node[font=\sffamily\small, text=BrandText] at (#1-#3/4,#2+15pt) {#4};
    \node[font=\sffamily\bfseries\Large, text=BrandPrimary] at (#1-#3/4,#2-5pt) {#5};
    % VS
    \node[circle, fill=BrandAccent, text=white, font=\sffamily\bfseries\small, minimum size=20pt] at (#1,#2) {VS};
    % Right side
    \node[font=\sffamily\small, text=BrandText] at (#1+#3/4,#2+15pt) {#6};
    \node[font=\sffamily\bfseries\Large, text=BrandSecondary] at (#1+#3/4,#2-5pt) {#7};
}

% =============================================================================
% ICON STAT
% =============================================================================
% Usage: \iconstat{x}{y}{icon}{value}{label}
\newcommand{\iconstat}[5]{
    \node[circle, fill=BrandPrimary, text=white, minimum size=50pt, font=\Large] at (#1,#2) {#3};
    \node[font=\sffamily\bfseries\LARGE, text=BrandPrimary] at (#1,#2-1.2) {#4};
    \node[font=\sffamily\small, text=BrandText] at (#1,#2-1.8) {#5};
}

% =============================================================================
% CHECKLIST ITEM
% =============================================================================
% Usage: \checkitem{x}{y}{text}{checked}  (checked = 1 or 0)
\newcommand{\checkitem}[4]{
    \ifnum#4=1
        \node[circle, fill=BrandSecondary, text=white, minimum size=16pt, font=\small] at (#1,#2) {\faCheck};
    \else
        \node[circle, draw=BrandText!30, minimum size=16pt] at (#1,#2) {};
    \fi
    \node[font=\sffamily\small, text=BrandText, anchor=west] at (#1+0.4,#2) {#3};
}

% =============================================================================
% TIMELINE (Horizontal)
% =============================================================================
% Usage: \htimeline{x1}{y}{x2}{{x/label/desc},...}
\newcommand{\htimeline}[4]{
    \draw[BrandText!30, line width=3pt] (#1,#2) -- (#3,#2);
    \foreach \xpos/\label/\desc in #4 {
        \node[circle, fill=BrandPrimary, minimum size=14pt] at (\xpos,#2) {};
        \node[font=\sffamily\bfseries\small, text=BrandPrimary, anchor=south] at (\xpos,#2+0.3) {\label};
        \node[font=\sffamily\scriptsize, text=BrandText, anchor=north, text width=50pt, align=center] at (\xpos,#2-0.3) {\desc};
    }
}

% =============================================================================
% VERTICAL FLOW
% =============================================================================
% Usage: \vflow{x}{y1}{y2}{{y/number/title/desc},...}
\newcommand{\vflow}[4]{
    \draw[BrandSecondary!40, line width=4pt] (#1,#2) -- (#1,#3);
    \foreach \ypos/\num/\title/\desc in #4 {
        \node[number badge] at (#1,\ypos) {\num};
        \node[font=\sffamily\bfseries, text=BrandPrimary, anchor=west] at (#1+0.6,\ypos+0.15) {\title};
        \node[font=\sffamily\small, text=BrandText, anchor=west, text width=150pt] at (#1+0.6,\ypos-0.25) {\desc};
    }
}

% =============================================================================
% MEDICAL: HEART RATE INDICATOR
% =============================================================================
% Usage: \heartrate{x}{y}{bpm}{status} (status: normal, elevated, high)
\newcommand{\heartrate}[4]{
    \def\statuscolor{BrandSecondary}
    \ifx#4\normal\def\statuscolor{BrandSecondary}\fi
    \def\temp{elevated}
    \ifx#4\temp\def\statuscolor{BrandAccent}\fi
    \def\temp{high}
    \ifx#4\temp\def\statuscolor{BrandAlert}\fi
    %
    \node[circle, fill=\statuscolor!15, minimum size=60pt] at (#1,#2) {};
    \node[font=\Large, text=\statuscolor] at (#1,#2+0.3) {\faHeartbeat};
    \node[font=\sffamily\bfseries, text=\statuscolor] at (#1,#2-0.4) {#3};
    \node[font=\sffamily\tiny, text=BrandText] at (#1,#2-0.8) {BPM};
}

% =============================================================================
% MEDICAL: RISK LEVEL BAR
% =============================================================================
% Usage: \risklevel{x}{y}{width}{level} (level: 0-100)
\newcommand{\risklevel}[4]{
    % Background gradient from green to red
    \shade[left color=BrandSecondary, right color=BrandAlert, rounded corners=3pt]
        (#1,#2) rectangle (#1+#3,#2+0.4);
    % Indicator
    \draw[BrandText, line width=2pt] (#1+#3*#4/100,#2-0.1) -- (#1+#3*#4/100,#2+0.5);
    \node[font=\sffamily\bfseries\small, text=BrandText] at (#1+#3*#4/100,#2+0.8) {#4\%};
    % Labels
    \node[font=\sffamily\tiny, text=BrandSecondary, anchor=west] at (#1,#2-0.3) {Low};
    \node[font=\sffamily\tiny, text=BrandAlert, anchor=east] at (#1+#3,#2-0.3) {High};
}

% =============================================================================
% QUOTE BOX
% =============================================================================
% Usage: \quotebox{x}{y}{width}{quote}{author}
\newcommand{\quotebox}[5]{
    \node[
        brand box,
        minimum width=#3,
        text width=#3-30pt,
        align=left,
        anchor=north
    ] at (#1,#2) {
        \textcolor{BrandPrimary}{\faQuoteLeft}\\[5pt]
        \textit{\textcolor{BrandText}{#4}}\\[8pt]
        \textcolor{BrandSecondary}{--- #5}
    };
}

% =============================================================================
% FEATURE LIST
% =============================================================================
% Usage: \featurelist{x}{y}{{icon/text},...}
\newcommand{\featurelist}[3]{
    \def\yoffset{0}
    \foreach \icon/\text in #3 {
        \node[text=BrandPrimary, font=\large] at (#1,#2-\yoffset) {\icon};
        \node[font=\sffamily\small, text=BrandText, anchor=west] at (#1+0.5,#2-\yoffset) {\text};
        \pgfmathsetmacro{\yoffset}{\yoffset + 0.6}
        \global\let\yoffset\yoffset
    }
}

\endinput
