# Life OS Project .gitignore

# =============================================================================
# SECRETS AND SENSITIVE DATA
# =============================================================================

# Environment files (contain API keys)
.env
.env.*
!.env.example
*.env

# Decrypted secrets (agenix decrypts to /run/agenix on NixOS)
*.secret
*.key
*.pem
*.decrypted
secrets/*.txt
secrets/*.key

# SSH keys
*.pub
id_*
!.ssh/known_hosts

# API credentials
credentials.json
service-account.json
*-credentials.json

# =============================================================================
# TERRAFORM / OPENTOFU STATE
# =============================================================================

# State files (contain sensitive infrastructure details)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform directories
.terraform/
.terraform.lock.hcl

# Terraform variable files (may contain secrets)
*.tfvars
*.tfvars.json
!*.tfvars.example

# OpenTofu
.tofu/

# =============================================================================
# NIX BUILD OUTPUTS
# =============================================================================

# Result symlinks from nix build
result
result-*

# Nix store paths (generated)
.nix-profile
.nix-defexpr

# direnv cache
.direnv/

# =============================================================================
# PYTHON
# =============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
pytest_cache/

# Translations
*.mo
*.pot

# Jupyter Notebook
.ipynb_checkpoints
*.ipynb_checkpoints/

# pyenv
.python-version

# Virtual environments
venv/
ENV/
env/
.venv/

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# pytype static type analyzer
.pytype/

# =============================================================================
# EDITORS AND IDES
# =============================================================================

# VSCode
.vscode/
*.code-workspace

# JetBrains (PyCharm, etc.)
.idea/
*.iml
*.ipr
*.iws
out/

# Vim
*.swp
*.swo
*~
.*.sw?

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

# Sublime Text
*.sublime-workspace
*.sublime-project

# =============================================================================
# OPERATING SYSTEM
# =============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# =============================================================================
# LOGS AND DATABASES
# =============================================================================

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local databases
*.db
*.sqlite
*.sqlite3

# =============================================================================
# LOCAL DATA AND CACHE
# =============================================================================

# Local development data
.data/
data/
*.data

# Cache directories
.cache/
cache/
*.cache

# Temporary files
tmp/
temp/
*.tmp
*.temp

# =============================================================================
# DOCKER
# =============================================================================

# Docker Compose override
docker-compose.override.yml
docker-compose.local.yml

# =============================================================================
# MISCELLANEOUS
# =============================================================================

# Backup files
*.bak
*.backup
*.old

# Archive files (shouldn't be in repo)
*.zip
*.tar.gz
*.rar
*.7z

# Large files
*.pdf
*.doc
*.docx
*.xls
*.xlsx
*.ppt
*.pptx

# Node modules (if any JS tools are used)
node_modules/
package-lock.json
yarn.lock

# Documentation build output
docs/_build/
site/
