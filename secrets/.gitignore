# Agenix Secrets .gitignore
#
# This directory should ONLY contain:
# - secrets.nix (secret definitions)
# - *.age files (encrypted secrets)
# - README.md (documentation)
# - .gitignore (this file)

# Ignore everything by default
*

# Allow only these files to be tracked
!secrets.nix
!*.age
!README.md
!.gitignore

# Explicitly ignore common decrypted secret patterns
*.key
*.pem
*.secret
*.decrypted
*.plaintext
*.txt
*.env
.env*

# Ignore any temporary files
*.tmp
*.temp
*.bak
*.swp
*~

# Ignore any shell history or editor files
.bash_history
.zsh_history
.viminfo
